{
    "name": "dfunes/sf-kata",
    "description": "Kata de arquitectura de Symfony: componentes, bundles, rutas y contenedor de servicios (Symfony 7.4 LTS)",
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-intl": "*",
        "phpdocumentor/reflection-docblock": "^6.0.3",
        "symfony/console": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/expression-language": "7.4.*",
        "symfony/filesystem": "7.4.*",
        "symfony/finder": "7.4.*",
        "symfony/flex": "^2.12",
        "symfony/framework-bundle": "7.4.*",
        "symfony/intl": "7.4.*",
        "symfony/options-resolver": "7.4.*",
        "symfony/property-access": "7.4.*",
        "symfony/property-info": "7.4.*",
        "symfony/runtime": "7.4.*",
        "symfony/serializer": "7.4.*",
        "symfony/type-info": "7.4.*",
        "symfony/yaml": "7.4.*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95.27",
        "phpstan/phpstan": "^2.3.4",
        "phpstan/phpstan-phpunit": "^2.1.1",
        "phpstan/phpstan-symfony": "^2.1.1",
        "phpunit/phpunit": "^12.5.43",
        "symfony/browser-kit": "7.4.*"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true,
        "platform": {
            "php": "8.4"
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "test": "@php bin/phpunit",
        "test:smoke": "@php bin/phpunit --testsuite smoke",
        "exercise1": "@php bin/phpunit --testsuite exercise1",
        "exercise2": "@php bin/phpunit --testsuite exercise2",
        "exercise3": "@php bin/phpunit --testsuite exercise3",
        "exercise4": "@php bin/phpunit --testsuite exercise4",
        "exercise5": "@php bin/phpunit --testsuite exercise5",
        "stan": [
            "@php bin/console cache:warmup --env=dev --no-interaction",
            "@php vendor/bin/phpstan analyse --memory-limit=1G"
        ],
        "cs": "@php vendor/bin/php-cs-fixer check --diff",
        "cs:fix": "@php vendor/bin/php-cs-fixer fix",
        "lint": [
            "@php bin/console lint:container",
            "@php bin/console lint:yaml config --parse-tags"
        ],
        "check": [
            "@composer validate --strict",
            "@composer audit --locked --abandoned=report",
            "@cs",
            "@stan",
            "@lint",
            "@test:smoke"
        ]
    },
    "scripts-descriptions": {
        "test": "Toda la suite: smoke y los cinco ejercicios (en master, los ejercicios fallan hasta resolverlos)",
        "test:smoke": "El kernel arranca y las rutas cargan",
        "exercise1": "Ejercicio 1: componentes de PHP",
        "exercise2": "Ejercicio 2: Filesystem y Finder",
        "exercise3": "Ejercicio 3: el bundle AcmeBlogBundle",
        "exercise4": "Ejercicio 4: las rutas de /topics",
        "exercise5": "Ejercicio 5: la extensión y el servicio del bundle",
        "stan": "Análisis estático (PHPStan); calienta antes el contenedor de dev que lee phpstan-symfony",
        "cs": "Comprueba el estilo sin tocar ficheros",
        "cs:fix": "Corrige el estilo",
        "lint": "Lint del contenedor y de la configuración YAML",
        "check": "Lo que ejecuta el CI, en orden y con el PHP local: validate, audit, cs, stan, lint y la suite"
    },
    "conflict": {
        "symfony/symfony": "*",
        "symfony/browser-kit": ">=8.0",
        "symfony/cache": ">=8.0",
        "symfony/config": ">=8.0",
        "symfony/console": ">=8.0",
        "symfony/dependency-injection": ">=8.0",
        "symfony/dom-crawler": ">=8.0",
        "symfony/dotenv": ">=8.0",
        "symfony/error-handler": ">=8.0",
        "symfony/event-dispatcher": ">=8.0",
        "symfony/expression-language": ">=8.0",
        "symfony/filesystem": ">=8.0",
        "symfony/finder": ">=8.0",
        "symfony/framework-bundle": ">=8.0",
        "symfony/http-foundation": ">=8.0",
        "symfony/http-kernel": ">=8.0",
        "symfony/intl": ">=8.0",
        "symfony/options-resolver": ">=8.0",
        "symfony/process": ">=8.0",
        "symfony/property-access": ">=8.0",
        "symfony/property-info": ">=8.0",
        "symfony/routing": ">=8.0",
        "symfony/runtime": ">=8.0",
        "symfony/serializer": ">=8.0",
        "symfony/stopwatch": ">=8.0",
        "symfony/string": ">=8.0",
        "symfony/type-info": ">=8.0",
        "symfony/var-dumper": ">=8.0",
        "symfony/var-exporter": ">=8.0",
        "symfony/yaml": ">=8.0"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.4.*"
        }
    }
}
